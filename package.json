{
  "name": "mi-follow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Descubra quem não te segue de volta no Instagram a partir do ZIP oficial do seu export.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "faang-ui": "^0.4.1",
    "fflate": "^0.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22"
  }
}
