{
  // Um Worker só: serve o site estático (`dist`) e a rota que lê o ZIP.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mifollow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  // Publicado só no domínio próprio; nenhum <worker>.workers.dev.
  "workers_dev": false,
  "routes": [
    { "pattern": "mifollow.fer.tec.br", "custom_domain": true }
  ],
  // Todo request passa pelo Worker, que decide: /api/* na mão, o resto nos assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Contas e análises guardadas (só quando a pessoa escolhe salvar).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-follow",
      "database_id": "32fd0a02-1697-4d08-a477-9a9113f9be71"
    }
  ],
  // Teto por IP: cada visita ganha um orçamento de análises por minuto.
  "ratelimits": [
    {
      "name": "ANALYZE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    },
    // Login e cadastro: bem menos, para senha errada não virar força bruta.
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
