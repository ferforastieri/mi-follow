{
  // Um Worker só: serve o site estático (`dist`) e a rota que lê o ZIP.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-follow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  // Todo request passa pelo Worker, que decide: /api/* na mão, o resto nos assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Teto por IP: cada visita ganha um orçamento de análises por minuto.
  "ratelimits": [
    {
      "name": "ANALYZE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  "workers_dev": true
}
